# MongoDB connection string (required)
MONGO_URI=mongodb://localhost:27017

# Port for `python app.py` (default 5001)
PORT=5001

# Address to listen on. Default: all interfaces (0.0.0.0). Use 127.0.0.1 when
# the app sits behind the https dev server (frontend `npm run dev:https`) so
# the API can only be reached through it; also set TRUST_PROXY_HOPS=1.
# HOST=127.0.0.1

# Secret used to sign faculty login tokens. Set a long random value in any
# deployment (e.g. `python -c "import secrets; print(secrets.token_hex(32))"`).
# If unset, a key is generated once into backend/.secret_key (git-ignored).
# SECRET_KEY=

# How long a faculty login stays valid, in seconds (default 28800 = 8 hours)
# TOKEN_MAX_AGE_SECONDS=28800

# Key for the admin-only routes (/faculty/add, /student/add, /assignment/add,
# /department/add, /classroom/add, /subject/add). Send it as `X-Admin-Key`.
# Leave unset to keep those routes switched off (the seed scripts don't need them).
# ADMIN_API_KEY=

# Flask's debugger is OFF by default because it lets anyone who can reach the
# port run code. Set to 1 only for local development; the server then listens
# on 127.0.0.1 only (so phones on your Wi-Fi can't reach it).
# FLASK_DEBUG=0

# --- Network rules ---------------------------------------------------------
# Main rule (no setting needed): a session accepts check-ins only from the
# network the faculty started it on. Private/LAN addresses are locked to their
# /24, public addresses (a cloud server sees the college's shared address) to
# that exact address, IPv6 to /64. The dashboard lists blocked attempts and the
# faculty can "Allow" a reported network, e.g. when the college Wi-Fi hands out
# addresses from several /24 blocks.
# NETWORK_LOCK_PREFIX_V4=24          # widen to 16/20 for a large college subnet
# NETWORK_LOCK_PUBLIC_PREFIX_V4=32   # lower (e.g. 29) if the college uses several public addresses

# Optional extra limit on top of the session lock: comma-separated CIDR ranges,
# or * (default) for none. Example: ALLOWED_NETWORKS=10.20.0.0/16
# ALLOWED_NETWORKS=*

# Number of reverse proxies in front of the app (Render = 1). 0 when the app
# is reached directly. Needed for the network check to see the real client IP.
# TRUST_PROXY_HOPS=1

# --- Rotating QR / check-in evidence ---------------------------------------
# The attendance QR carries a token that changes this often (seconds, min 5),
# so a shared screenshot stops working. The server accepts the current and the
# previous token, i.e. a QR is good for 1-2x this long.
# QR_ROTATE_SECONDS=8

# How long a student has, after scanning, to take the selfie and submit
# (seconds, min 20; also capped by the session's remaining time).
# CHECKIN_PASS_SECONDS=45

# Set to 1 to refuse selfies that did not come from the in-page live camera.
# Only works where the browser allows the camera (https, or localhost); over
# plain http on a LAN address students fall back to their phone's camera app,
# so leave this off until you serve the site over https.
# REQUIRE_LIVE_CAPTURE=0

# Set to 1 to reject selfies that look like a photo of a screen or a print.
# Needs two small DeepFace model files (MiniFASNet) downloaded once into
# ~/.deepface/weights on first use. Applies to check-in selfies only.
# ANTI_SPOOFING=0

# Days to keep check-in selfies (shown to the session's faculty). 0 = forever.
# CHECKIN_PHOTO_DAYS=30

# --- Face matching -----------------------------------------------------------
# Model used for matching. Default: Facenet512 (pass mark 0.30). It separated
# genuine phone check-ins (~0.25) from a different person (0.43+) far better
# than the old VGG-Face. Its ~94 MB weight file is downloaded by DeepFace on
# first use if missing, so the first check-in on a new machine is slow.
# Registered photos don't need to be redone when the model changes.
# FACE_MODEL=Facenet512

# Pass mark (cosine distance, lower = stricter). Unset = the model's own
# default (Facenet512 0.30; VGG-Face uses 0.50 here because DeepFace's 0.68
# let a stranger through). Raise it if real students are rejected.
# FACE_MATCH_THRESHOLD=0.30

# --- Proxy-attendance protections ------------------------------------------
# Each phone gets a server-signed id. In a normal session one phone can check
# in only ONE student (and, on a private LAN, one address can too). Sessions
# started with "Testing only: allow any network" skip this so you can test
# several USNs from one phone. Set to 0 to turn the rule off everywhere.
# ENFORCE_ONE_CHECKIN_PER_DEVICE=1

# Minutes an enrollment code stays valid (default 5). Registrations also need
# the faculty's approval before a student can check in.
# ENROLLMENT_MINUTES=5

# New phone ids handed out per address per 10 minutes (raise it if a whole
# class shares one public address and all of them are first-time users).
# DEVICE_TOKEN_ISSUE_LIMIT=100


# Registration photo checks (hands-free enrolment rejects unclear frames and
# says what to fix). Defaults suit phone selfies; loosen if students are
# turned away in a dim classroom.
# REGISTER_MIN_FACE_RATIO=0.22   # face width / picture width
# REGISTER_MIN_BRIGHTNESS=70
# REGISTER_MAX_BRIGHTNESS=200
# REGISTER_MIN_SHARPNESS=45
# REGISTER_MAX_TILT=18

# Matches between 85% of the pass mark and the pass mark are held for the
# faculty to confirm (look-alike / sibling protection). 0 = count them as
# present with a "Borderline match" flag instead.
# HOLD_BORDERLINE=1
